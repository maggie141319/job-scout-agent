# Copy to .env.local for local development. In Vercel, set these under
# Project Settings → Environment Variables. Never commit real values.

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres/Neon, RDS, or local).
# For Neon on Vercel use the *pooled* connection string, with sslmode=require.
DATABASE_URL=postgresql://user:password@host:5432/timeclock?sslmode=require

# Secret used to hash employee PINs (HMAC-SHA256). At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# WARNING: changing it invalidates every employee PIN (they must all be reset).
PIN_PEPPER=

# Optional: max connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# Test-only: a separate, disposable database used by `npm test` integration tests.
# Tests DROP and recreate all tables in it. Never point this at real data.
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5433/timeclock_test
